# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# AUDIO_SERVER_BASE_URL: Public base URL of your cloud audio folder or server.
AUDIO_SERVER_BASE_URL=https://deepstorage.dev/testappuser

# AUDIO_SERVER_CATALOG_ENDPOINT: Optional manifest or catalog endpoint relative to base URL (e.g. catalog.json or tracks.txt).
AUDIO_SERVER_CATALOG_ENDPOINT=AUTO_PROBE

# AUDIO_SERVER_DIRECT_TRACKS: Optional comma- or newline-separated direct audio filenames or full URLs (for hosts without directory indexing).
AUDIO_SERVER_DIRECT_TRACKS=NONE

# AUDIO_SERVER_AUTH_HEADER: Optional header name when AUDIO_SERVER_AUTH_TOKEN is set ("Authorization" sends "Bearer <token>").
AUDIO_SERVER_AUTH_HEADER=Authorization

# AUDIO_SERVER_AUTH_TOKEN: Optional Bearer token or API key only needed if your server restricts public access.
# AUDIO_SERVER_AUTH_TOKEN=OPTIONAL_AUDIO_SERVER_TOKEN
